{
  "name": "pharma-desktop-app",
  "version": "1.0.0",
  "description": "Offline Medical Store Management App",
  "author": "Ghulam Mustafa",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.17.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.pharma.app",
    "productName": "PharmaApp",
    "files": [
      "main.js",
      "package.json",
      "backend/**/*",
      "frontend/build/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "backend/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "backend/bin/",
        "to": "backend/bin/",
        "filter": ["*"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaApp"
    }
  }
}
